{
  "branding": {
    "appName": "Remote Workplace",
    "shortName": "Workplace"
  },
  "system": {
    "user": "your-user",
    "homeDirectory": "/home/your-user"
  },
  "tailscale": {
    "hostname": "server-name.tailnet.ts.net",
    "ip": "100.100.100.100",
    "httpsPort": 8443,
    "allowedUsers": [
      "user@example.com"
    ]
  },
  "paths": {
    "projectsRoot": "/home/your-user/projects",
    "orbitProjectBrowserRoot": "/home/your-user",
    "terminalAllowedRoots": [
      "/home/your-user"
    ],
    "terminalDefaultCwd": "/home/your-user",
    "dataDir": "/home/your-user/.local/share/remote-workplace",
    "browserProfilesRoot": "/home/your-user/.local/share/remote-workplace/browser-profiles",
    "orbitBackupDir": "/home/your-user/.local/share/remote-workplace/orbit-backups",
    "orbitAssetDir": "/home/your-user/.local/share/remote-workplace/orbit-assets",
    "fileGalleryDir": "/home/your-user/.local/share/remote-workplace/file-gallery",
    "workbenchProfilesRoot": "/home/your-user/.workbench-profiles",
    "codexSharedHome": "/home/your-user/.codex",
    "claudeSharedHome": "/home/your-user/.claude",
    "opencodeSharedHome": "/home/your-user/.local/share/opencode",
    "databasePath": "/home/your-user/.local/share/remote-workplace/workbench.sqlite"
  },
  "cli": {
    "codexbar": "/home/your-user/.local/bin/codexbar",
    "codex": "/home/your-user/.local/bin/codex",
    "opencode": "/home/your-user/.npm-global/bin/opencode",
    "claude": "/home/your-user/.local/bin/claude",
    "tmux": "/usr/bin/tmux",
    "chromium": "auto"
  },
  "codexbar": {
    "configPath": "/home/your-user/.config/codexbar/config.json",
    "oauthProfileHomes": []
  },
  "previews": {
    "slotPorts": [3901, 3902, 3903, 3904, 3905, 3906, 3907, 3908, 3909, 3910, 3911, 3912],
    "publicPorts": [8451, 8452, 8453, 8454, 8455, 8456, 8457, 8458, 8459, 8460, 8461, 8462]
  },
  "t3": {
    "channel": "stable",
    "npmPackage": "t3",
    "cliPath": "/home/your-user/.npm-global/bin/t3",
    "host": "127.0.0.1",
    "port": 3773,
    "serviceUnit": "t3-code.service",
    "legacyLauncher": "/home/your-user/.local/bin/t3-code-service",
    "installTimeoutSeconds": 300,
    "stopTimeoutSeconds": 20,
    "portTimeoutSeconds": 30,
    "healthTimeoutSeconds": 60
  }
}
