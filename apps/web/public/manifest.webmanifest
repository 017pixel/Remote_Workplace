{
  "id": "/workbench/",
  "name": "Remote Workplace",
  "short_name": "Workplace",
  "description": "Selbst gehostete Remote-Development-Workbench für Projekte, Tools und Serverinformationen.",
  "start_url": "/workbench/",
  "scope": "/workbench/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "window-controls-overlay"],
  "orientation": "any",
  "background_color": "#191919",
  "theme_color": "#191919",
  "categories": ["productivity", "developer"],
  "lang": "de",
  "dir": "ltr",
  "icons": [
    {
      "src": "/workbench/favicon.svg?v=2",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/workbench/icons/icon-192.png?v=2",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/workbench/icons/icon-512.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Workbench öffnen",
      "short_name": "Workbench",
      "description": "Geöffnete Werkzeuge und Previews verwalten.",
      "url": "/workbench/workbench",
      "icons": [{ "src": "/workbench/icons/icon-192.png?v=2", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Projekte",
      "short_name": "Projekte",
      "description": "Konfigurierte Projektordner auswählen.",
      "url": "/workbench/projects",
      "icons": [{ "src": "/workbench/icons/icon-192.png?v=2", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
