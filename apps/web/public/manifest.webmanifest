{
  "id": "/wrapt/",
  "name": "Wrapt",
  "short_name": "Wrapt",
  "description": "Selbst gehostete Remote-Development-Workbench für Projekte, Tools und Serverinformationen.",
  "start_url": "/wrapt/",
  "scope": "/wrapt/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "window-controls-overlay"],
  "orientation": "any",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "categories": ["productivity", "developer"],
  "lang": "de",
  "dir": "ltr",
  "icons": [
    {
      "src": "/wrapt/favicon.svg?v=4",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/wrapt/icons/icon-192.png?v=4",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/wrapt/icons/icon-512.png?v=4",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/wrapt/icons/icon-maskable-512.png?v=4",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Wrapt öffnen",
      "short_name": "Wrapt",
      "description": "Geöffnete Werkzeuge und Previews verwalten.",
      "url": "/wrapt/workbench",
      "icons": [{ "src": "/wrapt/icons/icon-192.png?v=4", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Projekte",
      "short_name": "Projekte",
      "description": "Konfigurierte Projektordner auswählen.",
      "url": "/wrapt/projects",
      "icons": [{ "src": "/wrapt/icons/icon-192.png?v=4", "sizes": "192x192", "type": "image/png" }]
    }
  ]
