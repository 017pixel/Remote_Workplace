{
  "name": "remote-workplace",
  "version": "0.30.3",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @workbench/contracts build && pnpm --parallel --filter @workbench/server --filter @workbench/web dev",
    "build": "pnpm --filter @workbench/contracts build && pnpm --filter @workbench/server build && pnpm --filter @workbench/web build",
    "typecheck": "pnpm --filter @workbench/contracts typecheck && pnpm --parallel --filter @workbench/server --filter @workbench/web typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @workbench/contracts build && pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:e2e": "playwright test",
    "start": "pnpm --filter @workbench/server start"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "17.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0"
  }
}
