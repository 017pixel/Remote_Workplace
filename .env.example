# -----------------------------------------------------------------------------
# .env — nur Secrets und neutrale Runtime-Einstellungen.
# Persönliche Werte (Name, Tailscale-Host, E-Mails, Pfade, CLI-Pfade, CodexBar)
# gehören NICHT hierher, sondern nach config/workbench.local.json
# (Vorlage: config/workbench.example.json). Env-Variablen hier überschreiben
# bei Bedarf einzelne Werte aus dieser Config.
# -----------------------------------------------------------------------------

# Workbench HTTP server. Keep HOST on localhost in production.
HOST=127.0.0.1
PORT=3010
APP_VERSION=0.25.0
LOG_LEVEL=info

# Optional alternate backend for the Vite development proxy.
WORKBENCH_DEV_BACKEND_URL=http://127.0.0.1:3010
# Nur für einen isolierten lokalen E2E-Proxy setzen, niemals in Produktion:
# WORKBENCH_DEV_TAILSCALE_USER=user@example.com

# Absolute paths may be used in systemd; relative paths resolve from the repo root.
CONFIG_DIR=./config
WEB_DIST_DIR=./apps/web/dist

# Project discovery. Roots live in config/workbench.local.json (paths.projectsRoot).
PROJECT_DISCOVERY_ENABLED=true
PROJECT_ACTIVITY_CACHE_MS=300000
PROJECT_ACTIVITY_MAX_DEPTH=8
ORBIT_RECENT_PROJECT_LIMIT=8
ORBIT_PROJECT_BROWSER_PAGE_SIZE=300

# Read-only polling/cache configuration in milliseconds.
METRICS_CACHE_MS=5000
SUMMARY_CACHE_MS=30000
SERVICE_CACHE_MS=10000
LOCAL_PORT_CACHE_MS=5000
LOCAL_PORT_PROBE_TIMEOUT_MS=450
REQUEST_TIMEOUT_MS=3000
COMPRESSION_THRESHOLD_BYTES=1024
BROTLI_QUALITY=4

# Protect only /api/**. Editor/Vite proxy traffic is intentionally excluded.
API_RATE_LIMIT_MAX=180
# code-server emits WebSocket frames larger than 64 KiB during startup.
WEBSOCKET_MAX_PAYLOAD_BYTES=16777216

# Local CodexBar service used for project-grouped cost history.
# The CLI path and config path live in config/workbench.local.json (cli.codexbar, codexbar.configPath).
CODEXBAR_BASE_URL=http://127.0.0.1:18181
CODEXBAR_CACHE_MS=60000
CODEXBAR_TIMEOUT_MS=35000

# Opt-in fallback when CodexBar omits an active 5-hour Codex window.
# Profile homes live in config/workbench.local.json (codexbar.oauthProfileHomes).
CODEX_OAUTH_PRIMARY_FALLBACK=false
CODEX_OAUTH_TIMEOUT_MS=5000

# Reverse proxy timeout for embedded services (code-server, previews, T3 Code).
PROXY_TIMEOUT_MS=15000

# Browser terminal session limits. Allowed users/roots live in config/workbench.local.json.
TERMINAL_MAX_SESSIONS=24
TERMINAL_SUPERVISOR=tmux

# Interactive agent CLI session limits. Executable paths live in config/workbench.local.json (cli.*).
CODEX_MAX_SESSIONS=12
OPENCODE_MAX_SESSIONS=12
CLAUDE_MAX_SESSIONS=4

# Headless Chromium sessions used by the integrated Browser tool.
# The Chromium path and profiles root live in config/workbench.local.json.
BROWSER_MAX_SESSIONS=4
BROWSER_STARTUP_TIMEOUT_MS=15000
BROWSER_IDLE_TIMEOUT_MS=1800000
BROWSER_CAPTURE_MAX_WIDTH=2560
BROWSER_CAPTURE_MAX_HEIGHT=1800
BROWSER_CAPTURE_MAX_SCALE=2
BROWSER_CAPTURE_JPEG_QUALITY=90
BROWSER_CAPTURE_EVERY_NTH_FRAME=2

# Persistent local usage history. The database path lives in config/workbench.local.json.
USAGE_SNAPSHOT_INTERVAL_MS=300000

# Server-persisted Orbit document. Backup/asset dirs live in config/workbench.local.json.
ORBIT_SYNC_INTERVAL_MS=5000
ORBIT_DOCUMENT_MAX_BYTES=4194304
ORBIT_ASSET_MAX_FILE_BYTES=104857600
ORBIT_ASSET_MAX_TOTAL_BYTES=53687091200
ORBIT_DESTRUCTIVE_DROP_PERCENT=50

# File gallery (Dateigalerie). Upload dir lives in config/workbench.local.json (fileGalleryDir).
FILE_GALLERY_MAX_FILE_BYTES=104857600
FILE_GALLERY_MAX_TOTAL_BYTES=53687091200

# Tech TLDRs. Keep the real API key only in .env. Leave empty to disable AI features.
MISTRAL_API_KEY=
MISTRAL_API_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL_INGEST=mistral-small-2603
MISTRAL_MODEL_CHAT=mistral-medium-3-5
MISTRAL_MODEL_EMBED=mistral-embed-2312
NEWS_SYNC_INTERVAL_MS=1800000
NEWS_FETCH_TIMEOUT_MS=12000
NEWS_MAX_ITEMS_PER_SOURCE=16
NEWS_AI_CONCURRENCY=1

# T3 Code (single instance behind the /t3 proxy). The channel (stable|nightly) itself lives in
# config/workbench.local.json under "t3.channel" — it is written by Settings -> T3 Code Kanal.
T3_CLI_PATH=/home/your-user/.npm-global/bin/t3
T3_NPM_PACKAGE=t3
T3_HOST=127.0.0.1
T3_PORT=3773
T3_SERVICE_UNIT=t3-code.service
