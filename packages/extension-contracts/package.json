{
  "name": "@workbench/extension-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema/extension-manifest-v1.schema.json": "./schema/extension-manifest-v1.schema.json",
    "./schema/extension-catalog-v1.schema.json": "./schema/extension-catalog-v1.schema.json",
    "./schema/extension-package-descriptor-v1.schema.json": "./schema/extension-package-descriptor-v1.schema.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/generate-json-schema.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "semver": "7.8.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/semver": "7.8.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
