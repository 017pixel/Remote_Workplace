{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "manifestVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "keywords": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 48
      }
    },
    "icon": {
      "type": "string",
      "maxLength": 512,
      "allOf": [
        {
          "pattern": "^\\.\\/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?(?:\\/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)*$"
        },
        {
          "pattern": "\\.(?:png|webp|jpe?g)$"
        }
      ]
    },
    "readme": {
      "type": "string",
      "maxLength": 512,
      "allOf": [
        {
          "pattern": "^\\.\\/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?(?:\\/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)*$"
        },
        {
          "pattern": "\\.md$"
        }
      ]
    },
    "changelog": {
      "type": "string",
      "maxLength": 512,
      "allOf": [
        {
          "pattern": "^\\.\\/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?(?:\\/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)*$"
        },
        {
          "pattern": "\\.md$"
        }
      ]
    },
    "dataSchemaVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "engines": {
      "type": "object",
      "properties": {
        "remoteWorkplace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "extensionApi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^\\S(?:.*\\S)?$"
        }
      },
      "required": [
        "remoteWorkplace",
        "extensionApi"
      ],
      "additionalProperties": false
    },
    "trust": {
      "type": "string",
      "enum": [
        "system",
        "builtin",
        "catalog-first-party",
        "developer",
        "sandboxed-webview"
      ]
    },
    "entrypoints": {
      "type": "object",
      "properties": {
        "ui": {
          "type": "string",
          "maxLength": 512,
          "allOf": [
            {
              "pattern": "^\\.\\/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?(?:\\/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)*$"
            },
            {
              "pattern": "\\.(?:c|m)?js$"
            }
          ]
        },
        "server": {
          "type": "string",
          "maxLength": 512,
          "allOf": [
            {
              "pattern": "^\\.\\/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?(?:\\/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)*$"
            },
            {
              "pattern": "\\.(?:c|m)?js$"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "maxItems": 23,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "permission": {
                "type": "string",
                "enum": [
                  "projects.read",
                  "projects.write",
                  "files.read",
                  "files.write",
                  "git.read",
                  "git.write",
                  "terminal.create",
                  "terminal.input",
                  "preview.read",
                  "preview.manage",
                  "agents.invoke"
                ]
              },
              "scope": {
                "type": "object",
                "properties": {
                  "projects": {
                    "minItems": 1,
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "current"
                        },
                        {
                          "type": "string",
                          "pattern": "^id:[a-z0-9]+(?:-[a-z0-9]+)*$"
                        }
                      ]
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "projects"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "permission"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "permission": {
                "type": "string",
                "const": "process.execute"
              },
              "scope": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "projects": {
                        "minItems": 1,
                        "maxItems": 64,
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": "string",
                              "const": "current"
                            },
                            {
                              "type": "string",
                              "pattern": "^id:[a-z0-9]+(?:-[a-z0-9]+)*$"
                            }
                          ]
                        },
                        "uniqueItems": true
                      },
                      "commands": {
                        "minItems": 1,
                        "maxItems": 64,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
                        },
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "projects"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "projects": {
                        "minItems": 1,
                        "maxItems": 64,
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": "string",
                              "const": "current"
                            },
                            {
                              "type": "string",
                              "pattern": "^id:[a-z0-9]+(?:-[a-z0-9]+)*$"
                            }
                          ]
                        },
                        "uniqueItems": true
                      },
                      "commands": {
                        "minItems": 1,
                        "maxItems": 64,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
                        },
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "commands"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "permission"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "permission": {
                "type": "string",
                "const": "network.fetch"
              },
              "scope": {
                "type": "object",
                "properties": {
                  "hosts": {
                    "minItems": 1,
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 253,
                      "pattern": "^(?=.*[a-z])(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "hosts"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "permission"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "permission": {
                "type": "string",
                "enum": [
                  "notifications.create",
                  "browser.control",
                  "agents.tools.register",
                  "agents.skills.register",
                  "storage.read",
                  "storage.write",
                  "system.metrics.read"
                ]
              }
            },
            "required": [
              "permission"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "permission": {
                "type": "string",
                "const": "secrets.request"
              },
              "scope": {
                "type": "object",
                "properties": {
                  "names": {
                    "minItems": 1,
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "names"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "permission"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "permission": {
                "type": "string",
                "enum": [
                  "system.services.read",
                  "system.services.control"
                ]
              },
              "scope": {
                "type": "object",
                "properties": {
                  "services": {
                    "minItems": 1,
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9@_.-]*[A-Za-z0-9@_-])?\\.service$"
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "services"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "permission"
            ],
            "additionalProperties": false
          }
        ]
      },
      "uniqueItems": true
    },
    "activationEvents": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "onStartup",
              "onProject",
              "onGitRepository",
              "onAgent"
            ]
          },
          {
            "type": "string",
            "maxLength": 202,
            "pattern": "^onCommand:[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?)*$"
          },
          {
            "type": "string",
            "maxLength": 200,
            "pattern": "^onRoute:[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?)*$"
          },
          {
            "type": "string",
            "maxLength": 204,
            "pattern": "^onOrbitNode:[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?)*$"
          },
          {
            "type": "string",
            "maxLength": 200,
            "pattern": "^onEvent:[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?)*$"
          },
          {
            "type": "string",
            "maxLength": 203,
            "pattern": "^onSchedule:[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?)*$"
          }
        ]
      },
      "uniqueItems": true
    },
    "contributes": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  "required": [
    "manifestVersion",
    "id",
    "name",
    "version",
    "publisher",
    "description",
    "license",
    "engines",
    "trust",
    "entrypoints",
    "permissions",
    "activationEvents",
    "contributes"
  ],
  "additionalProperties": false,
  "$id": "urn:remote-workplace:extension-manifest:v1",
  "title": "Remote Workplace Extension Manifest V1",
  "description": "Kanonischer Vertrag für lokale Remote-Workplace-Extensions mit Manifest-Version 1."
}
