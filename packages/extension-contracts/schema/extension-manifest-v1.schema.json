{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "manifestVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "keywords": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 48
      }
    },
    "icon": {
      "type": "string",
      "maxLength": 512,
      "allOf": [
        {
          "pattern": "^\\.\\/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?(?:\\/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)*$"
        },
        {
          "pattern": "\\.(?:png|webp|jpe?g)$"
        }
      ]
    },
    "readme": {
      "type": "string",
      "maxLength": 512,
      "allOf": [
        {
          "pattern": "^\\.\\/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?(?:\\/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)*$"
        },
        {
          "pattern": "\\.md$"
        }
      ]
    },
    "changelog": {
      "type": "string",
      "maxLength": 512,
      "allOf": [
        {
          "pattern": "^\\.\\/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?(?:\\/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)*$"
        },
        {
          "pattern": "\\.md$"
        }
      ]
    },
    "dataSchemaVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "engines": {
      "type": "object",
      "properties": {
        "remoteWorkplace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "extensionApi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^\\S(?:.*\\S)?$"
        }
      },
      "required": [
        "remoteWorkplace",
        "extensionApi"
      ],
      "additionalProperties": false
    },
    "trust": {
      "type": "string",
      "enum": [
        "system",
        "builtin",
        "catalog-first-party",
        "developer",
        "sandboxed-webview"
      ]
    },
    "entrypoints": {
      "type": "object",
      "properties": {
        "ui": {
          "type": "string",
          "maxLength": 512,
          "allOf": [
            {
              "pattern": "^\\.\\/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?(?:\\/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)*$"
            },
            {
              "pattern": "\\.(?:c|m)?js$"
            }
          ]
        },
        "server": {
          "type": "string",
          "maxLength": 512,
          "allOf": [
            {
              "pattern": "^\\.\\/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?(?:\\/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)*$"
            },
            {
              "pattern": "\\.(?:c|m)?js$"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "maxItems": 0,
      "type": "array",
      "items": {
        "not": {}
      }
    },
    "activationEvents": {
      "maxItems": 0,
      "type": "array",
      "items": {
        "not": {}
      }
    },
    "contributes": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  "required": [
    "manifestVersion",
    "id",
    "name",
    "version",
    "publisher",
    "description",
    "license",
    "engines",
    "trust",
    "entrypoints",
    "permissions",
    "activationEvents",
    "contributes"
  ],
  "additionalProperties": false,
  "$id": "urn:remote-workplace:extension-manifest:v1",
  "title": "Remote Workplace Extension Manifest V1",
  "description": "Kanonischer Vertrag für lokale Remote-Workplace-Extensions mit Manifest-Version 1."
}
