[Unit]
Description=CodexBar local usage API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bbecker
Group=bbecker
Environment=HOME=/home/bbecker
Environment=XDG_CACHE_HOME=/var/lib/codexbar/cache
Environment=CODEXBAR_CONFIG_PATH=/home/bbecker/.config/codexbar/config.json
ExecStart=/home/bbecker/.local/bin/codexbar serve --port 18181 --refresh-interval 60 --request-timeout 30
Restart=always
RestartSec=5s
RuntimeMaxSec=4h
LimitNOFILE=65536
TimeoutStopSec=20s
KillSignal=SIGTERM
UMask=0077
StateDirectory=codexbar
StateDirectoryMode=0700

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
