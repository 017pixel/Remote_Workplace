[Unit]
Description=Benjamin Dev Workbench (user)
After=network-online.target code-server.service tg-vereinsapp-preview.service
Wants=network-online.target code-server.service tg-vereinsapp-preview.service

[Service]
Type=simple
WorkingDirectory=/home/bbecker/projects/Remote_Workplace
Environment=NODE_ENV=production
EnvironmentFile=-/home/bbecker/projects/Remote_Workplace/.env
ExecStartPre=/home/bbecker/projects/Remote_Workplace/deploy/systemd/stop-legacy-workbench.sh
ExecStart=/home/bbecker/.npm-global/bin/pnpm --filter @workbench/server start
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
